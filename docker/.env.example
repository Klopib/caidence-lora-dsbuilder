# Copy to .env and adjust. Every value is optional; the defaults work as-is.
# Only the 'florence' captioning provider uses this file.

# Where Hugging Face and torch cache model weights. Florence-2 large is ~1.5GB,
# and the cache is usually shared between projects, so point these at a shared
# location to avoid re-downloading per clone.
# Defaults: ../.cache/huggingface and ../.cache/torch inside the repo.
#HF_CACHE_DIR=D:/models/huggingface
#TORCH_CACHE_DIR=D:/models/torch

# Host port for the Florence-2 API.
#FLORENCE_PORT=8080

# Florence-2 variant. 'base' is smaller and faster; 'large' captions better.
#FLORENCE_MODEL_ID=microsoft/Florence-2-large

# Only needed for gated Hugging Face repos.
#HF_TOKEN=
