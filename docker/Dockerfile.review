FROM python:3.10-slim

WORKDIR /workspace

# Copy the review UI script into the image
COPY review_ui.py /workspace/review_ui.py

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        gradio==4.31.4 \
        gradio_client==0.16.4 \
        pillow==9.5.0 \
        huggingface_hub==0.23.4 \
    && pip install --no-cache-dir --force-reinstall \
        fastapi==0.110.2 \
        starlette==0.37.2

EXPOSE 7861

CMD ["python", "/workspace/review_ui.py", "--help"]
