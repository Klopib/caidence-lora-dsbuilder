# Container form of the caption review UI.
#
# Optional. The UI is a small Gradio app and runs on the host by default;
# this image exists only for machines with no Python available.
#
# Previously this pinned gradio 4.31.4 and force-reinstalled fastapi and
# starlette to work around that version's dependency conflicts. Current Gradio
# installs cleanly with no pins, so the workaround is gone.
FROM python:3.13-slim

WORKDIR /workspace

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir gradio

COPY review_ui.py /workspace/review_ui.py

EXPOSE 7861

CMD ["python", "/workspace/review_ui.py", "--help"]
